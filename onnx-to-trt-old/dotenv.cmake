if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/.env")
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/.env" DOT_ENV_CONTENTS)
  string(REGEX REPLACE "[\r\n]" ";" DOT_ENV_CONTENTS "${DOT_ENV_CONTENTS}")
  foreach(LINE ${DOT_ENV_CONTENTS})
    if(LINE MATCHES "^([^#][^=]*)=(.*)$")
      set(ENV{${CMAKE_MATCH_1}} ${CMAKE_MATCH_2})
    endif()
  endforeach()
endif()